# Canonical site URL (metadata, JSON-LD, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.ctstours.co.nz

# --- Ceepii redesign staging isolation (see docs/redesign/ceepii-assessment.md §4) ---
# Which environment this build serves. Inlined at build time, so staging and
# production must be separate builds — NOT toggleable at runtime.
#   production | staging | development
NEXT_PUBLIC_ENV=production

# Basic auth for staging.chinatravel.co.nz. Only used when NEXT_PUBLIC_ENV=staging.
# /api/*, /_next/*, /robots.txt, /sitemap.xml, /favicon.ico bypass auth (子牙 fix
# — otherwise staging lead APIs return 401 and the lead channel dies).
# STAGING_USER=ctspreview
# STAGING_PASS=use-a-long-random-string

# Separate GA4 + GTM properties for staging so production dashboards stay clean.
# When NEXT_PUBLIC_ENV=staging, GoogleAnalytics.tsx / GoogleTagManager.tsx resolve
# to these _STAGING vars via src/lib/env.ts helpers.
# NEXT_PUBLIC_GA_ID_STAGING=G-STAGINGXXXX
# NEXT_PUBLIC_GTM_ID_STAGING=GTM-STAGINGXX

# ⚠️ REDIRECT_ONRENDER_HOST — production only. NEVER set this on the staging
# Render service: it consumes the host-typed redirect in next.config.js and
# 308s staging traffic to www.ctstours.co.nz, breaking the preview entirely.
# REDIRECT_ONRENDER_HOST=chinatravel-zloe.onrender.com


# Supabase (public + server-only service role for /admin image APIs)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin image CMS (MVP: shared secret; httpOnly cookie + x-admin-key)
# Claude API key for the admin tour parser (/admin/tour-parser)
ANTHROPIC_API_KEY=sk-ant-...

ADMIN_SECRET_KEY=use-a-long-random-string

# Resend — required for /api/tour-enquiry, /api/tailor-made-enquiry, /api/contact, and /api/send-itinerary
RESEND_API_KEY=re_xxxxxxxx

# Optional: inbox for tour + contact form notifications (defaults to info@ctstours.co.nz)
# ENQUIRY_NOTIFY_EMAIL=

# Google Tag Manager ID
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Analytics 4 Measurement ID — enables device/age/source reporting
# Set this in Render to start collecting real visitor data (component is wired in layout)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Ads Conversion IDs (optional, for direct Google Ads tracking)
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=your_conversion_label

# Password gate for /marketing/campaign (min 12 chars). If unset, campaign board stays public (local dev).
# Render: add as secret env; share this value with clients as the login password.
# MARKETING_PLAN_ACCESS_KEY=use-a-long-random-string-here

# Newsletter — Mailchimp integration (double opt-in, subscriber management)
# API key format: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us19  (datacenter suffix after the dash)
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us19
MAILCHIMP_AUDIENCE_ID=xxxxxxxxxx
MAILCHIMP_DATACENTER=us19

# Wavespeed AI — image generation for social automation (Phase 2)
# Used by: scripts/social-image-generator.* (planned)
WAVESPEED_API_KEY=apikey-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── WhatsApp + Messenger CRM ────────────────────────────────────────────────
# Setup guide: src/app/api/webhooks/SETUP.md

# WhatsApp Cloud API (Meta for Developers → WhatsApp → API Setup)
WHATSAPP_ACCESS_TOKEN=EAAxxxxxx...                  # System user token or temp token
WHATSAPP_PHONE_NUMBER_ID=1234567890123              # Phone Number ID from API Setup tab
WHATSAPP_WEBHOOK_VERIFY_TOKEN=cts-wa-verify-secret  # Any random string — used for webhook verification

# Messenger (Meta for Developers → Messenger → Settings)
MESSENGER_PAGE_ACCESS_TOKEN=EAAxxxxxx...            # Page Access Token
MESSENGER_WEBHOOK_VERIFY_TOKEN=cts-msg-verify-secret # Any random string
